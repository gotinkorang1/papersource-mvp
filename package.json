{
  "name": "papersource",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d",
    "db:migrate": "node scripts/apply-sql.mjs",
    "db:seed": "tsx scripts/seed-catalogue.ts",
    "db:reset": "docker compose up -d && node scripts/apply-sql.mjs && tsx scripts/seed-catalogue.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "email": "email dev --dir src/lib/email/templates --port 3001",
    "auth:start": "node scripts/local-supabase.mjs start",
    "auth:stop": "node scripts/local-supabase.mjs stop",
    "auth:bootstrap": "node scripts/local-supabase.mjs bootstrap",
    "auth:test:guards": "node --test scripts/local-supabase.test.mjs scripts/test-local-auth.test.mjs",
    "auth:test": "pnpm auth:test:guards && node scripts/test-local-auth.mjs",
    "auth:test:profiles": "node --conditions=react-server --import tsx scripts/test-customer-profile.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "next": "16.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "^6.9.3",
    "react-hook-form": "^7.86.0",
    "resend": "^6.24.0",
    "server-only": "0.0.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "supabase": "2.116.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.20.0"
}
