DATABASE_URL=postgresql://papersource:papersource@127.0.0.1:54329/papersource
# Empty uses mock checkout at /pay/mock. Set PAYSTACK_MODE=live to call Paystack.
PAYSTACK_SECRET_KEY=
PAYSTACK_MODE=
RESEND_API_KEY=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SENTRY_DSN=
