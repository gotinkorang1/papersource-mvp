# Public (safe in the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Server only — never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Dedicated PaperSource Postgres from docker compose. Do not point this at another project.
DATABASE_URL=postgresql://papersource:papersource@127.0.0.1:54329/papersource
# Empty uses mock checkout at /pay/mock. Set PAYSTACK_MODE=live to call Paystack.
PAYSTACK_SECRET_KEY=
PAYSTACK_MODE=
# Empty uses the in-memory inbox. Set EMAIL_MODE=live to call Resend.
EMAIL_MODE=
EMAIL_FROM=PaperSource <paper@papersource.test>
STAFF_NOTIFY_EMAIL=sales@papersource.test
RESEND_API_KEY=
# Local staff /admin login. Seeded: sales@, admin@, warehouse@, content@ papersource.test.
# Production must set this; STAFF_MODE=live (Supabase Auth) is a later phase.
STAFF_DEV_SECRET=sk_staff_papersource_local
STAFF_MODE=
# Empty uses the local .data/documents store. Set STORAGE_MODE=live for Supabase Storage.
STORAGE_MODE=
DOCUMENT_SIGNING_SECRET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.1
