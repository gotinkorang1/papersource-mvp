# Public (safe in the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Social profiles and optional Meta Page Plugin (leave false unless verified in production)
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/papersourcegh
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/papersourcegh/
NEXT_PUBLIC_FACEBOOK_EMBED_ENABLED=false
# Required in addition to the flag above before the Meta Page Plugin is shown.
# Leave unset to use the reliable page/comment links instead of a broken iframe.
NEXT_PUBLIC_FACEBOOK_PAGE_ID=
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required for authenticated customer/admin browser tests and SSR auth.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Browser verification — set explicitly for hosted runs; leave localhost for local E2E.
PLAYWRIGHT_BASE_URL=http://localhost:3000
STAFF_E2E_EMAIL=
STAFF_E2E_PASSWORD=
# Required for hosted state-changing Quick Order/checkout journeys. Use a
# dedicated production-safe SKU with known pricing tiers; local runs may leave
# these empty unless the local database has been seeded with the same fixture.
E2E_CATALOGUE_SKU=
E2E_CATALOGUE_SLUG=
E2E_CATALOGUE_NAME=
E2E_SECONDARY_CATALOGUE_SKU=
E2E_SECONDARY_CATALOGUE_NAME=

# Server only — never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Dedicated PaperSource Postgres from docker compose. Do not point this at another project.
# Replace the placeholder with the local password; never copy this value to hosted environments.
DATABASE_URL=postgresql://papersource:YOUR_LOCAL_PASSWORD@127.0.0.1:54329/papersource
# Empty uses mock checkout at /pay/mock. Set PAYSTACK_MODE=live to call Paystack.
PAYSTACK_SECRET_KEY=
PAYSTACK_MODE=
# Empty uses the in-memory inbox. Set EMAIL_MODE=live to call Resend.
EMAIL_MODE=
EMAIL_FROM=PaperSource <paper@papersource.test>
STAFF_NOTIFY_EMAIL=sales@papersource.test
RESEND_API_KEY=
# Local-only staff /admin login fallback. Keep empty by default; production staff access uses Supabase Auth and admin_roles.
STAFF_DEV_SECRET=
STAFF_MODE=
# Empty uses the local .data/documents store. Set STORAGE_MODE=live for Supabase Storage.
STORAGE_MODE=
DOCUMENT_SIGNING_SECRET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.1
CRON_SECRET=
# Optional bearer token for detailed /api/health integration diagnostics.
HEALTHCHECK_SECRET=
